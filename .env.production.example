# PRODUCTION environment for the Next server (Advisory). Copy to your host's environment settings (or to .env.production.local), fill every value.
# Server-only: never prefix with NEXT_PUBLIC_ (except the one below), never commit real values. This file holds NO real values.

# ---- site and database ----------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://advisory.gcode.in

# ORDS address of the WKSP_GCODE2 schema, WITH /v1, no trailing slash. (The database setting of the same name has NO /v1: do not mix them up.)
ORDS_BASE_URL=https://g39bc7cd4ecbbbb-gcdev01.adb.ap-hyderabad-1.oraclecloudapps.com/ords/wksp_gcode2/v1

# Signs the onboarding cookie. 32+ random characters: openssl rand -base64 48
AUTH_SECRET=

# ---- shared keys: each must EQUAL the value in the database (GCODE_APP_SECRETS), the ones you put in 04-settings.sql ----------------------
PAYMENT_SERVER_KEY=
MEETING_SERVER_KEY=

# ---- Cashfree payments (collect) ------------------------------------------------------------------------------------------------------
# "production" for real money; anything else (or empty) = sandbox.
CASHFREE_ENV=production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Leave unset: the app picks the right Cashfree address from CASHFREE_ENV. Only set it to override.
# CASHFREE_API_BASE=

# ---- Cashfree payouts (money to experts) ----------------------------------------------------------------------------------------------
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# The payout public key (PEM). On one line with \n for the line breaks, or paste it as a multi-line value if your host allows.
CASHFREE_PAYOUT_PUBLIC_KEY=

# ---- Zoho Meeting (video calls) -------------------------------------------------------------------------------------------------------
# Data centre of your Zoho account: in | com | eu | com.au | jp ...
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_PRESENTER_ID=
ZOHO_SOURCE_NAME=GCODE

# ---- scheduler (optional) -------------------------------------------------------------------------------------------------------------
# Lets a scheduler call GET /api/cron/attendance (Authorization: Bearer <value>). At least 16 characters. Unset = the route answers 404.
CRON_SECRET=

# ======================================================================================================================================
# The switches are in the DATABASE, not here (run in SQL Commands after the app is deployed and the smoke test passed):
#   payments ON :  UPDATE gcode_app_secrets SET secret_value = 'Y'    WHERE secret_name = 'PAYMENTS_ENABLED';  COMMIT;
#   Zoho ON     :  UPDATE gcode_app_secrets SET secret_value = 'ZOHO' WHERE secret_name = 'MEETING_PROVIDER';  COMMIT;
#   jobs ON     :  BEGIN DBMS_SCHEDULER.ENABLE('GCODE_BOOKING_SWEEP'); DBMS_SCHEDULER.ENABLE('GCODE_PAYOUT_BATCH'); END;
# Payments without Zoho keys, or Zoho without payments, both work: they are independent.
# ======================================================================================================================================

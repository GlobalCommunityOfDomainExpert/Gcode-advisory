NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# ORDS base, no trailing slash, e.g. https://<host>/ords/wksp_gcode2/v1
ORDS_BASE_URL=http://127.0.0.1:9100/ords/v1
# Signs the onboarding cookie. 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
# DATABASE_URL=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# DAILY_API_KEY=
# EMAIL_API_KEY=

# Video calls (Zoho Meeting), server only. Leave empty to use the local stand-in room.
# Switch the database to Zoho with: INSERT INTO GCODE_APP_SECRETS (SECRET_NAME, SECRET_VALUE) VALUES ('MEETING_PROVIDER', 'ZOHO');
ZOHO_DC=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_PRESENTER_ID=
ZOHO_SOURCE_NAME=GCODE
# Must equal GCODE_APP_SECRETS MEETING_SERVER_KEY in the database. Long random value in production.
MEETING_SERVER_KEY=
# Lets a scheduler call GET /api/cron/attendance (Authorization: Bearer <value>). At least 16 characters. Unset = the route answers 404.
CRON_SECRET=

# Microsoft Clarity project id (public, from the Clarity dashboard). Only used in production builds. Leave empty to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
